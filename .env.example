# =============================================================================
# LLM Application Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# At minimum, you need at least one LLM provider API key to use this application

# =============================================================================
# LLM Provider API Keys (At least one required)
# =============================================================================
# OpenAI API Key - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key - Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI API Key - Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq API Key - Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Cohere API Key - Get from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
# PostgreSQL connection strings - Get from Vercel Postgres or Neon
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_HOST=
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Alternative: Single DATABASE_URL (if not using Vercel Postgres)
DATABASE_URL=postgresql://user:password@host/database

# Redis URL (for caching and rate limiting) - Optional
# Get from: https://upstash.com or any Redis provider
REDIS_URL=redis://localhost:6379

# =============================================================================
# Supabase Configuration
# =============================================================================
# Supabase project credentials - Get from: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# =============================================================================
# Application Security (Required for production)
# =============================================================================
# Secret for encrypting API keys in database
API_KEY_ENCRYPTION_SECRET=your_32_character_encryption_key

# Secret for session management
SESSION_SECRET=your_32_character_session_secret

# =============================================================================
# Application Settings
# =============================================================================
# Node environment (development, production)
NODE_ENV=development

# Application URL (for callbacks and webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
